# Flowmates — copy to .env.local and fill in.
#
# Nothing here is compiled into the binary by default. A build without this file
# runs local-only: measurement, local analysis and local reports work; sign-in,
# sync and integrations report themselves unavailable.
#
# NEXT_PUBLIC_* / VITE_*  → may end up in the frontend bundle (public by design).
# TAURI_*                 → read by Rust only; use TAURI_* for OAuth secrets, never VITE_*.

# --- Backend -----------------------------------------------------------------
# Base URL and public key of the backend you operate. Leave empty for a
# local-only build.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Integrations ------------------------------------------------------------
# Jira/Atlassian — register an app at https://developer.atlassian.com/console/myapps/
# The ID may be public; the secret must never carry a VITE_ prefix.
TAURI_JIRA_CLIENT_ID=""
TAURI_JIRA_CLIENT_SECRET=""

# Linear — https://linear.app/settings/api
TAURI_LINEAR_CLIENT_ID=""
TAURI_LINEAR_CLIENT_SECRET=""

# --- Update signing (tauri-plugin-updater) -----------------------------------
# Generate the key pair with:
#   pnpm --filter @flowmates/windows exec tauri signer generate -w <path>
# The PUBLIC half goes in apps/agent/src-tauri/tauri.conf.json (pubkey), committed.
# The PRIVATE half is secret: never commit it. In CI it lives as a GitHub Secret.
# Needed locally only for `pnpm build`, since createUpdaterArtifacts signs the installer.
# Losing the private key is final: no installed copy would ever accept an update again.
TAURI_SIGNING_PRIVATE_KEY=""
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flowmates",
  "version": "1.0.0",
  "identifier": "eu.flowmates.windows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm --filter @flowmates/windows vite",
    "beforeBuildCommand": "pnpm --filter @flowmates/windows exec node ../../scripts/fetch-models.mjs && pnpm --filter @flowmates/windows vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Flowmates",
        "width": 370,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 340,
        "minHeight": 400,
        "decorations": false,
        "theme": "Light",
        "backgroundColor": "#FAFAFA"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420 https://*.supabase.co wss://*.supabase.co; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob: https:; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../../local_llm/bin/llama-server.exe": "local_llm/bin/llama-server.exe",
      "../../../local_llm/bin/*.dll": "local_llm/bin/",
      "../../../local_llm/Qwen3-VL-2B-Instruct-Q3_K_M.gguf": "local_llm/Qwen3-VL-2B-Instruct-Q3_K_M.gguf",
      "../../../local_llm/mmproj-Qwen3VL-2B-Instruct-Q8_0.gguf": "local_llm/mmproj-Qwen3VL-2B-Instruct-Q8_0.gguf"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyQTQyODQ0OUNENEY5MTcKUldRWCtkU2NSQ2lrZ2d1TE1wdW1DQm85aVJtYWxNK1o2dnJNa3VCUEtrejVJM0VsM3E3WlIyRWEK",
      "endpoints": [
        "https://github.com/khalilami2005-ctrl/flowmates-agent/releases/latest/download/latest-windows.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
